---
import "../../styles/global.css";

import { getCollection } from "astro:content";

export async function getStaticPaths() {
    const games = await getCollection("games");

    return games.map((game) => ({
        params: { slug: game.id },
        props: { game },
    }));
}

const { game } = Astro.props;

async function fetchYoutubeVideoOembed(url: string) {
    const res = await fetch(
        `https://www.youtube.com/oembed?url=${url}&format=json`,
    );
    return res.json();
}

const sectionsWithData = await Promise.all(
    game.data.sections.map(async (section) => {
        const links = await Promise.all(
            section.links.map(async (link) => {
                const data = await fetchYoutubeVideoOembed(link);
                return {
                    url: link,
                    title: data.title,
                    thumbnail: data.thumbnail_url,
                };
            }),
        );

        return {
            ...section,
            links,
        };
    }),
);

const zgames = await getCollection("games");
---

<head>
    <title>{game.data.title} | Tuneage</title>
</head>
<body>
    <header>
        <div class="header-content">
            {
                zgames.map((g) => (
                    <nav>
                        <a href={`/tuneage/games/${g.id}`}>{g.data.title}</a>
                    </nav>
                ))
            }
        </div>
    </header>
    <main>
        <article>
            <img
                id="ytThumbImg"
                style="width:512px; height: 384px; float: right;"
            />
            <h1>{game.data.title}</h1>

            <!-- Loop through sections -->
            {
                sectionsWithData.map((section) => (
                    <section>
                        <h3>{section.title}</h3>

                        <ul>
                            {section.links.map((link) => (
                                <li>
                                    <a
                                        class="a-link"
                                        href={link.url}
                                        target="_blank"
                                        data-uri={link.thumbnail}
                                    >
                                        {link.title}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))
            }
        </article>
    </main>

    <script is:inline>
        const themes = [
            "theme-solar", // 0 - Sun
            "theme-charcoal", // 1 - Mon
            "theme-plum", // 2 - Tue
            "theme-aqua", // 3 - Wed
            "theme-forest", // 4 - Thu
            "theme-ember", // 5 - Fri
            "theme-slate", // 6 - Sat
        ];
        const dow = new Date().getDay();
        const classname = themes[dow];
        document.documentElement.classList.add(classname);
    </script>

    <script>
        const img = document.getElementById("ytThumbImg") as any;
        document.querySelectorAll(".a-link").forEach((link) => {
            link.addEventListener("mouseenter", (e: any) => {
                img!.src = e.target.dataset.uri;
            });
        });
    </script>
</body>
